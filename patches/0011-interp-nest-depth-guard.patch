--- a/js/src/vm/Interpreter.cpp
+++ b/js/src/vm/Interpreter.cpp
@@ -427,6 +427,31 @@
     return false;
   }
 
+#if defined(__EMSCRIPTEN__)
+  // Live RunScript activations == nested wasm call chains on the host stack.
+  // V8's real-stack overflow is an uncatchable RangeError that kills the app
+  // pthread, so make the cap catchable here. GECKO_NESTMAX=<n> bounds it
+  // (0/off by default), GECKO_NESTDBG logs depth milestones.
+  static uint32_t gNestDepth = 0, gNestMax = 0;
+  static bool gNestDbg = false, gNestInit = false;
+  if (!gNestInit) {
+    gNestInit = true;
+    if (const char* e = getenv("GECKO_NESTMAX"); e && *e) {
+      gNestMax = strtoul(e, nullptr, 10);
+    }
+    gNestDbg = getenv("GECKO_NESTDBG") != nullptr;
+  }
+  const uint32_t nestDepth = ++gNestDepth;
+  auto nestGuard = mozilla::MakeScopeExit([] { --gNestDepth; });
+  if (gNestDbg && nestDepth >= 2048 && nestDepth % 2048 == 0) {
+    fprintf(stderr, "[nest] depth=%u\n", nestDepth);
+  }
+  if (gNestMax && nestDepth > gNestMax) {
+    cx->onOverRecursed();
+    return false;
+  }
+#endif
+
   MOZ_ASSERT_IF(cx->runtime()->hasJitRuntime(),
                 !cx->runtime()->jitRuntime()->disallowArbitraryCode());
 
