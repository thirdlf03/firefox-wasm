+#ifdef __EMSCRIPTEN__
+namespace js::wasm {
+extern int32_t gWJHostDepth;
+extern int32_t gWJHostDepthLimit;
+}  // namespace js::wasm
+
+JS_PUBLIC_API void js::IncEmscriptenHostCharge(int32_t charge) {
+  js::wasm::gWJHostDepth += charge;
+}
+
+JS_PUBLIC_API void js::DecEmscriptenHostCharge(int32_t charge) {
+  js::wasm::gWJHostDepth -= charge;
+}
+
+JS_PUBLIC_API bool js::EmscriptenHostChargeExceeded() {
+  static int32_t envLimit = [] {
+    const char* env = getenv("GECKO_HOSTLIMIT");
+    return env ? atoi(env) : -1;
+  }();
+  int32_t lim = envLimit >= 0 ? envLimit : js::wasm::gWJHostDepthLimit;
+  return js::wasm::gWJHostDepth > lim;
+}
+#endif  // __EMSCRIPTEN__
