+#ifdef __EMSCRIPTEN__
+namespace js::wasm {
+extern int32_t gWJJitDepth;
+extern int32_t gWJJitDepthLimit;
+}  // namespace js::wasm
+
+JS_PUBLIC_API void js::IncEmscriptenHostCharge(int32_t charge) {
+  js::wasm::gWJJitDepth += charge;
+}
+
+JS_PUBLIC_API void js::DecEmscriptenHostCharge(int32_t charge) {
+  js::wasm::gWJJitDepth -= charge;
+}
+
+JS_PUBLIC_API bool js::EmscriptenHostChargeExceeded() {
+  return js::wasm::gWJJitDepth > js::wasm::gWJJitDepthLimit;
+}
+#endif  // __EMSCRIPTEN__
