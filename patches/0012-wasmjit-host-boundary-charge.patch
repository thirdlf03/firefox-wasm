+static bool WJChargeHostBoundary(int kind) {
+  static int32_t charge = [] {
+    const char* env = getenv("GECKO_WJ_HELPCOST");
+    if (!env) return int32_t(6000);
+    char* end;
+    long long cost = strtoll(env, &end, 10);
+    return end != env && !*end && cost > 0 && cost <= INT32_MAX
+               ? int32_t(cost)
+               : int32_t(6000);
+  }();
+  int32_t savedDepth = gWJJitDepth;
+  int64_t chargedDepth = int64_t(savedDepth) + charge;
+  // Coercions/proxies can re-enter JS; allow PBL helpers while suspended.
+  if (chargedDepth > gWJJitDepthLimit) {
+    static int crossDbg = getenv("GECKO_WJ_HELPCROSDBG") ? 1 : 0;
+    if (crossDbg) {
+      fprintf(stderr, "[wj-xrefuse] depth=%d charge=%d lim=%d kind=%d\n",
+              savedDepth, charge, gWJJitDepthLimit, kind);
+    }
+    if (JSContext* cx = js::TlsContext.get()) {
+      js::ReportOverRecursed(cx);
+    }
+    return false;
+  }
+  gWJJitDepth = int32_t(chargedDepth);
+  return true;
+}
