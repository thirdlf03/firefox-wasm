+static bool WJChargeHostBoundary(int kind) {
+  static int32_t charge = [] {
+    const char* env = getenv("GECKO_WJ_HELPCOST");
+    if (!env) return int32_t(6000);
+    char* end;
+    long long cost = strtoll(env, &end, 10);
+    return end != env && !*end && cost > 0 && cost <= INT32_MAX
+               ? int32_t(cost)
+               : int32_t(6000);
+  }();
+  static int32_t hostLimit = [] {
+    const char* env = getenv("GECKO_HOSTLIMIT");
+    return env ? atoi(env) : 0;
+  }();
+  if (hostLimit > 0) gWJHostDepthLimit = hostLimit;
+  int32_t savedDepth = gWJHostDepth;
+  int64_t chargedDepth = int64_t(savedDepth) + charge;
+  // Coercions/proxies can re-enter JS; allow PBL helpers while suspended.
+  if (chargedDepth > gWJHostDepthLimit) {
+    static int crossDbg = getenv("GECKO_WJ_HELPCROSDBG") ? 1 : 0;
+    if (crossDbg) {
+      fprintf(stderr, "[wj-xrefuse] depth=%d charge=%d lim=%d kind=%d\n",
+              savedDepth, charge, gWJHostDepthLimit, kind);
+    }
+    // Latch suspension (in WJ-account units): further JS->WJ edges delegate to
+    // PBL instead of growing the already-deep host stack.
+    if (gWJJitDepth < gWJSuspendWatermark) {
+      gWJSuspendWatermark = gWJJitDepth;
+    }
+    return false;
+  }
+  gWJHostDepth = int32_t(chargedDepth);
+  return true;
+}
