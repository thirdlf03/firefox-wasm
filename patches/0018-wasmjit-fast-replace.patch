+// Global replace of a simple character class that does not match returns the
+// input string (and zeros lastIndex). String_replace's prologue calls this so
+// the common no-match case skips RegExpReplace / searcher / Substring.
+static double WJFastReplace() {
+  static int off = getenv("GECKO_WJ_NOFASTREPLACE") ? 1 : 0;
+  if (off) return 3.0;
+  JSContext* cx = js::TlsContext.get();
+  if (!cx) return 3.0;
+  JS::Value thisv = JS::Value::fromRawBits(gWJScratch[js::wasm::kWJThisSlot]);
+  JS::Value search = JS::Value::fromRawBits(gWJScratch[0]);
+  if (!thisv.isString() || !search.isObject()) return 3.0;
+  JSObject* obj = &search.toObject();
+  if (!js::IsOptimizableRegExpObject(obj, cx)) return 3.0;
+  js::RegExpObject& rx = obj->as<js::RegExpObject>();
+  JS::RegExpFlags flags = rx.getFlags();
+  if (!flags.global() || flags.ignoreCase() || flags.unicode() ||
+      flags.unicodeSets() || flags.sticky() || flags.hasIndices()) {
+    return 3.0;
+  }
+  JSAtom* src = rx.getSource();
+  if (!src || src->length() < 3 || src->length() > 64) return 3.0;
+  char16_t buf[64];
+  size_t n = src->length();
+  {
+    JS::AutoCheckCannotGC nogc;
+    if (src->hasLatin1Chars()) {
+      const JS::Latin1Char* p = src->latin1Chars(nogc);
+      for (size_t i = 0; i < n; i++) buf[i] = p[i];
+    } else {
+      const char16_t* p = src->twoByteChars(nogc);
+      for (size_t i = 0; i < n; i++) buf[i] = p[i];
+    }
+  }
+  if (buf[0] != '[' || buf[n - 1] != ']' || buf[1] == '^') return 3.0;
+  uint8_t set[128] = {};
+  bool any = false;
+  for (size_t i = 1; i + 1 < n;) {
+    char16_t ch = buf[i];
+    if (ch == '\\') {
+      if (i + 2 >= n) return 3.0;
+      char16_t e = buf[i + 1];
+      if (e == 'n') ch = '\n';
+      else if (e == 't') ch = '\t';
+      else if (e == 'r') ch = '\r';
+      else if (e == '\\' || e == ']' || e == '[' || e == '-' || e == '^' ||
+               e == '.')
+        ch = e;
+      else
+        return 3.0;
+      i += 2;
+    } else if (ch == '-') {
+      return 3.0;
+    } else {
+      i += 1;
+    }
+    if (ch >= 128) return 3.0;
+    set[ch] = 1;
+    any = true;
+  }
+  if (!any) return 3.0;
+  std::vector<JSString*> pending;
+  pending.push_back(thisv.toString());
+  while (!pending.empty()) {
+    if (pending.size() > 2048) return 3.0;
+    JSString* cur = pending.back();
+    pending.pop_back();
+    if (!cur->isLinear()) {
+      JSRope& rope = cur->asRope();
+      pending.push_back(rope.leftChild());
+      pending.push_back(rope.rightChild());
+      continue;
+    }
+    JSLinearString* lin = &cur->asLinear();
+    JS::AutoCheckCannotGC nogc;
+    if (lin->hasLatin1Chars()) {
+      const JS::Latin1Char* p = lin->latin1Chars(nogc);
+      size_t len = lin->length();
+      for (size_t i = 0; i < len; i++) {
+        if (p[i] < 128 && set[p[i]]) return 3.0;
+      }
+    } else {
+      const char16_t* p = lin->twoByteChars(nogc);
+      size_t len = lin->length();
+      for (size_t i = 0; i < len; i++) {
+        if (p[i] < 128 && set[p[i]]) return 3.0;
+      }
+    }
+  }
+  rx.zeroLastIndex(cx);
+  gWJScratch[js::wasm::kWJResultSlot] = thisv.asRawBits();
+  static int dbg = getenv("GECKO_WJ_FASTREPLACEDBG") ? 1 : 0;
+  if (dbg) {
+    static uint64_t hits = 0;
+    if ((++hits % 100000) == 0)
+      fprintf(stderr, "[wj-fastreplace] hits=%llu\n", (unsigned long long)hits);
+  }
+  return 0.0;
+}
