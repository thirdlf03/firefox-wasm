+static bool WJIsStringReplace(JSScript* sc) {
+  if (!sc || !sc->filename() || !strstr(sc->filename(), "self-hosted")) return false;
+  // Pinned self-hosted line of String_replace (obj selfhosted.js). The atom
+  // check covers a regenerated line number.
+  if (sc->lineno() == 4307) return true;
+  JSFunction* f = sc->function();
+  if (!f) return false;
+  JSAtom* a = f->maybePartialDisplayAtom();
+  if (!a || !a->hasLatin1Chars() || a->length() != 13) return false;
+  JS::AutoCheckCannotGC nogc;
+  const JS::Latin1Char* c = a->latin1Chars(nogc);
+  const char* name = "String_replace";
+  for (size_t i = 0; i < 13; i++)
+    if (c[i] != uint8_t(name[i])) return false;
+  return true;
+}
