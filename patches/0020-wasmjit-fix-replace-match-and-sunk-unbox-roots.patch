+// Push the boxed Value spilled to gWJCallRoots for a root local (kind as in
+// WJCollectRoots). A sunk Unbox local is boxed only while its input still has
+// the unboxed tag; otherwise it spills undefined so the GC never traces the
+// payload of e.g. `undefined` as a JSObject*.
+static bool EmitBoxRootLocal(Encoder& e, WJBackend& be, uint32_t local,
+                             uint8_t kind) {
+  static const MIRType kKindType[] = {MIRType::Value, MIRType::Object,
+                                      MIRType::String, MIRType::Symbol,
+                                      MIRType::BigInt};
+  if (!GetLocal(e, local)) return false;
+  if (kind && !EmitBoxFromStack(e, kKindType[kind])) return false;
+  auto s = be.sunkUnboxLocals.find(local);
+  if (s == be.sunkUnboxLocals.end()) return true;
+  return e.writeOp(Op::I64Const) &&
+         e.writeVarS64(int64_t(JS::UndefinedValue().asRawBits())) &&
+         GetLocal(e, s->second.first) && e.writeOp(Op::I64Const) &&
+         e.writeVarS64(32) && e.writeOp(Op::I64ShrU) &&
+         e.writeOp(Op::I32WrapI64) && e.writeOp(Op::I32Const) &&
+         e.writeVarS32(int32_t(s->second.second)) && e.writeOp(Op::I32Eq) &&
+         e.writeOp(Op::SelectNumeric);
 }
 
